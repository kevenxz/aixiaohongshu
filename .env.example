APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai

# 公网部署必须设置；APP_PASSWORD 为空时关闭认证（仅限本机）
APP_USERNAME=admin
APP_PASSWORD=
# MCP 通过 URL 取图时使用，不能为空（公网部署时设置一个随机值）
APP_MEDIA_TOKEN=
# Caddy 自动 HTTPS 的域名；使用自带 compose 时填写
DOMAIN=
DATABASE_PATH=data/workflow.db
MEDIA_DIR=data/media
EXPORT_DIR=data/exports
# 多账号配置；文件不存在时回退为单账号（沿用本文件里的旧配置）
ACCOUNTS_FILE=config/accounts.yaml

# 访问 Reddit / X / YouTube 需要代理时填写（requests 会自动读取；不用就保持注释）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# 每天目标总量，默认三平台合计 30 条
TARGET_POSTS_PER_DAY=30
COLLECT_CRON=0 8 * * *
FETCH_PER_PROVIDER=20
AI_KEYWORDS=ai,artificial intelligence,machine learning,deep learning,llm,generative ai,chatgpt,openai,claude,gemini,anthropic,人工智能,大模型,生成式 ai,机器学习
AI_ONLY=true
MIN_AI_SCORE=0.15

# LLM（OpenAI-compatible Chat Completions）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# 连续调用时的最小间隔和 429/5xx 重试次数
LLM_THROTTLE_SECONDS=1.5
LLM_MAX_RETRIES=4

# Reddit Data API：在 https://www.reddit.com/prefs/apps 创建 script 应用
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 如果注册流程要求独立 bot 账号，这里填 bot 账号用户名；不要把密码写进 .env
REDDIT_USER_AGENT=xhs-workflow/0.2 by u/your-bot-username
REDDIT_SUBREDDITS=artificial,MachineLearning,LocalLLaMA,OpenAI,ChatGPT
REDDIT_SORT=hot
REDDIT_TOP_TIME=day
# auto：有 API 凭证走 OAuth，没有则用公开 RSS；api/rss 可强制指定
REDDIT_MODE=auto

# 官方博客 / AI 新闻 RSS，无需 key。格式：名称|URL，多个用逗号分隔
RSS_FEEDS=OpenAI|https://openai.com/news/rss.xml,Google DeepMind|https://deepmind.google/blog/rss.xml

# X API v2：recent search 需要 Basic 及以上付费套餐
X_BEARER_TOKEN=
# AI 主题搜索流
X_QUERIES=AI OR artificial intelligence,LLM,ChatGPT OR OpenAI,Claude OR Gemini
# 重点账号流：填写需要重点关注的 AI 账号（不带 @，逗号分隔）
X_PRIORITY_ACCOUNTS=OpenAI,AnthropicAI,GoogleDeepMind
# 或把重点账号放进一个公开 X List，填 List ID 或完整链接
X_LIST_ID=
# 重点账号热度加权；true 表示重点账号内容跳过 AI 关键词过滤
X_PRIORITY_BOOST=4
X_PRIORITY_ALL=true

# YouTube Data API v3：在 Google Cloud 启用 API 后创建 Key
YOUTUBE_API_KEY=
YOUTUBE_QUERIES=AI news,AI agents,large language model,ChatGPT,Claude,OpenAI
YOUTUBE_REGION_CODE=US
YOUTUBE_DAYS=7
# 排除 Shorts：short / medium / long / any
YOUTUBE_VIDEO_DURATION=medium
YOUTUBE_LANGUAGE=en

# 图片处理：是否下载未核验版权的来源图片（YouTube 封面等），使用前确认授权
ALLOW_UNVERIFIED_REPOST=false
MEDIA_TIMEOUT_SECONDS=20
MEDIA_MAX_BYTES=10485760

# 发布器：manual、webhook 或 mcp
PUBLISHER=manual
PUBLISH_WEBHOOK_URL=
# xpzouying/xiaohongshu-mcp：默认监听 18060，工具名为 publish_content
# 如果启用了 AUTH_TOKEN，把同一个 token 填到 XHS_MCP_AUTH_TOKEN
XHS_MCP_SERVER_URL=http://localhost:18060/mcp
XHS_MCP_TOOL_NAME=publish_content
XHS_MCP_AUTH_TOKEN=
# 测试阶段建议先设为「仅自己可见」
XHS_MCP_VISIBILITY=公开可见
# Docker 跨容器发布图片时设置，例如 http://app:8000/media；本地留空即可
XHS_MEDIA_BASE_URL=

# 微博 H5 接口的 Cookie（仅明星账号使用；遇到 432 时从浏览器 m.weibo.cn 更新）
WEIBO_COOKIE=
# 明星账号的独立小红书 MCP（默认本机 18061）；Docker 内由 compose 覆盖为服务名
XHS_MCP_STAR_URL=http://127.0.0.1:18061/mcp
XHS_MCP_TOKEN_STAR=

# 审核后自动发布：每天只发当天已批准的图文，最多 N 条
# 默认关闭；开启前请确认账号授权和内容审核流程
AUTO_PUBLISH=false
AUTO_PUBLISH_CRON=30 9 * * *
AUTO_PUBLISH_LIMIT=3
